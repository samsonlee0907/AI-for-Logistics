# The portal is mock-first. Set WEBIQ_ENABLED=true only with both values below.
WEBIQ_API_KEY=
WEBIQ_ENABLED=false

# Embedded Azure OpenAI / Microsoft Foundry advisory provider. In Azure Container Apps,
# a system-assigned managed identity authenticates with no API key or browser configuration.
FOUNDRY_ENDPOINT=
FOUNDRY_DEPLOYMENT=
# Required for portal access. Store actual values in environment secrets, never source control.
PORTAL_AUTH_USERNAME=
PORTAL_AUTH_PASSWORD=
# Generate a random value with at least 32 characters.
PORTAL_AUTH_SESSION_SECRET=
PORT=3000
